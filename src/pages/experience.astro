---
// experience.astro
import {
    Card,
    CardHeader,
    CardTitle,
    CardDescription,
    CardContent,
} from '@/components/ui/card'
import Layout from '@/layouts/Layout.astro'
import { marked } from 'marked'

import ArfaKarimExperience from '@/Content/ArfaKarimExperience.md?raw'
import CambridgeFinance from '@/Content/CambridgeFinance.md?raw'
import MicrosoftAI from '@/Content/MicrosoftAI.md?raw'

import IdCard from '@lucide/astro/icons/id-card'
import Building from '@lucide/astro/icons/building'
import History from '@lucide/astro/icons/history'
import { AvatarCircles } from '@/components/ui/avatar-circles'

const experiences = [
    {
        dates: '2025 - 2026 (8 Months)',
        headline: 'AI & Machine Learning Trainee',
        description: marked(ArfaKarimExperience),
        organization: 'Arfa Karim Technology Incubator',
        location: 'Lahore, Pakistan',
    },
    {
        dates: 'May 2026 (35 Hours)',
        headline: 'Foundations of AI and Machine Learning',
        description: marked(MicrosoftAI),
        organization: 'Microsoft',
        location: 'Online / Remote',
    },
    {
        dates: 'May 2026 (30 Hours)',
        headline: 'Foundations of Finance',
        description: marked(CambridgeFinance),
        organization: 'University of Cambridge',
        location: 'Online / Remote',
    },
]
---

<Layout
    title='Experience'
    description='A detailed overview of Subhan Kashif’s professional experience, highlighting roles, responsibilities, and impact across multiple organizations'
>
    <div class='relative max-w-3xl mx-auto py-8 px-4 lg:px-0'>
        {
            experiences.map((exp, index) => (
                <div class='relative pb-8'>
                    <div class='relative flex items-start space-x-4'>
                        <Card className='flex-1 bg-secondary-background'>
                            <CardHeader className='flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1'>
                                <div class='space-y-1'>
                                    <CardTitle className='flex items-center gap-2'>
                                        <IdCard size={20} />
                                        {exp.headline}
                                    </CardTitle>
                                    <CardDescription className='flex items-center gap-2'>
                                        <Building size={18} />
                                        {exp.organization} • {exp.location}
                                    </CardDescription>
                                </div>

                                <div>
                                    <CardDescription className='flex items-center gap-2'>
                                        <History size={20} />
                                        {exp.dates}
                                    </CardDescription>
                                </div>
                            </CardHeader>
                            <CardContent>
                                <div
                                    class='prose prose-sm dark:prose-invert max-w-none'
                                    set:html={exp.description}
                                />
                            </CardContent>
                        </Card>
                    </div>
                </div>
            ))
        }
    </div>
</Layout>
